# ========================
# FindBack .gitignore
# ========================

# ----- Python / Backend -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
.venv/
ENV/

# ----- Environment variables (CRITICAL - never push secrets) -----
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env

# ----- Node / Frontend -----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- OS files -----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ----- Uploads (user-uploaded images - don't push to repo) -----
uploads/
!uploads/.gitkeep

# ----- Model cache / weights -----
models/
*.pt
*.pth
*.onnx
*.bin
*.safetensors
.cache/

# ----- Docker -----
docker-compose.override.yml

# ----- Database -----
*.db
*.sqlite3
pgdata/

# ----- Logs -----
logs/
*.log

# ----- Coverage / Testing -----
htmlcov/
.coverage
.pytest_cache/
.tox/

# ----- Misc -----
*.bak
*.tmp
*.temp
implementation_plan*.md
