# ========================
# FindBack Environment Variables
# ========================
# Copy this file to .env and fill in the values

# ----- Database -----
DATABASE_URL=postgresql://findback_user:findback_pass@localhost:5432/findback_db

# ----- JWT -----
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- LLM Provider (choose one) -----
# Option A: Google Gemini (free tier)
# GEMINI_API_KEY=your-gemini-api-key

# Option B: Groq (free tier, fast)
# GROQ_API_KEY=your-groq-api-key

# Option C: Ollama (local, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Active LLM provider: gemini | groq | ollama
LLM_PROVIDER=gemini

# ----- Embedding Model -----
# sentence-transformers model name (runs locally, free)
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenCLIP model for image embeddings (runs locally, free)
IMAGE_EMBEDDING_MODEL=ViT-B-32
IMAGE_EMBEDDING_PRETRAINED=laion2b_s34b_b79k

# ----- File Upload -----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ----- Frontend URL (for CORS) -----
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# ----- Matching Thresholds -----
TEXT_SIMILARITY_WEIGHT=0.4
IMAGE_SIMILARITY_WEIGHT=0.4
METADATA_WEIGHT=0.2
MATCH_THRESHOLD=0.60
